# ════════════════════════════════════════════════════════════════════
#  Hair Home Concept — variables d'environnement
#  Copier en .env.local (développement) ou les saisir dans Vercel → Settings → Environment Variables.
#  Aucune de ces valeurs ne doit être publiée ni commitée.
# ════════════════════════════════════════════════════════════════════

# URL publique du site (sans / final) — sert au sitemap, aux balises canonical, aux e-mails.
NEXT_PUBLIC_SITE_URL=https://www.hairhomeconcept.com

# ── Base de données Neon (PostgreSQL) ───────────────────────────────
# Rôle propriétaire : administration authentifiée, migrations, initialisation.
# Utiliser l'URL « Pooled connection » (hôte contenant -pooler) en production.
DATABASE_URL=postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# (Recommandé) Rôle public restreint par RLS : lecture des contenus publiés + création des demandes.
# Créé par la migration 0001 ; activer sa connexion dans Neon (voir README, étape 3).
DATABASE_URL_PUBLIC=postgresql://hhc_public:MOT_DE_PASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

DATABASE_POOL_MAX=5

# ── Sécurité ────────────────────────────────────────────────────────
# Chaîne aléatoire longue (ex. `openssl rand -base64 48`). Sert à anonymiser les adresses IP.
AUTH_SECRET=remplacer-par-une-longue-chaine-aleatoire

# ── Images : Vercel Blob ────────────────────────────────────────────
# Créé automatiquement en ajoutant un « Blob Store » au projet Vercel (onglet Storage).
BLOB_READ_WRITE_TOKEN=

# ── E-mails : Resend ────────────────────────────────────────────────
# Notification à chaque demande de rendez-vous. Domaine d'envoi à vérifier dans Resend.
RESEND_API_KEY=
EMAIL_FROM="Hair Home Concept <rendez-vous@hairhomeconcept.com>"

# ── Google Maps (facultatif) ────────────────────────────────────────
# Clé « Maps Embed API » restreinte au domaine du site. Sans clé, l'intégration publique est utilisée.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ── Création du premier compte (script npm run admin:create, facultatif) ──
# ADMIN_EMAIL=
# ADMIN_NAME=Angèle
# ADMIN_PASSWORD=
